{
    "name": "@qthinker/opencode-deepseek-search",
    "version": "0.3.2",
    "description": "DeepSeek Search & Fetch for OpenCode V2: a switchable websearch backend, clean Markdown fetch, local usage/cost stats, and TUI + desktop sidebars",
    "type": "module",
    "license": "MIT",
    "author": "QThinker",
    "homepage": "https://github.com/QThinkerJR/opencode-deepseek-search#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/QThinkerJR/opencode-deepseek-search.git"
    },
    "bugs": {
        "url": "https://github.com/QThinkerJR/opencode-deepseek-search/issues"
    },
    "keywords": [
        "opencode",
        "opencode-plugin",
        "deepseek",
        "websearch",
        "search",
        "fetch",
        "usage",
        "cost",
        "tui",
        "desktop",
        "sidebar",
        "i18n"
    ],
    "files": [
        "index.ts",
        "tui.ts",
        "gui-experimental.cjs",
        "src",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.gui.json",
        "test": "node --test test/*.test.ts",
        "build:gui": "vite build",
        "smoke": "node --experimental-strip-types scripts/smoke.ts",
        "prepublishOnly": "npm run typecheck && npm test && npm run build:gui"
    },
    "peerDependencies": {
        "@opencode/plugin": ">=2.2.5",
        "@opencode/theme": ">=2.2.5",
        "@opentui/core": ">=0.8.0",
        "@opentui/solid": ">=0.8.0",
        "solid-js": ">=1.9.0"
    },
    "peerDependenciesMeta": {
        "@opencode/plugin": {
            "optional": true
        },
        "@opencode/theme": {
            "optional": true
        },
        "@opentui/core": {
            "optional": true
        },
        "@opentui/solid": {
            "optional": true
        },
        "solid-js": {
            "optional": true
        }
    },
    "devDependencies": {
        "@opencode/plugin": "2.2.5",
        "@opencode/theme": "2.2.5",
        "@opentui/core": "^0.8.0",
        "@opentui/solid": "^0.8.0",
        "@types/node": "^24.0.0",
        "solid-js": "^1.9.0",
        "typescript": "^5.9.0",
        "vite": "^7.3.7",
        "vite-plugin-solid": "^2.11.10"
    },
    "main": "./index.ts",
    "publishConfig": {
        "access": "public"
    }
}
